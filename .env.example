# .env.example - copie en .env et remplis les valeurs
# ASTROPATH ne stocke AUCUN token GitHub ici. OpenCode herite de `gh auth login`.

# Bot Telegram (via @BotFather, illimite et gratuit)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# GROQ pour transcription vocale voice messages (free tier)
# Recupere ta cle sur https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Timeout session OpenCode en secondes (default 300 = 5 min)
OPENCODE_TIMEOUT=300
